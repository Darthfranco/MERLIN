# Copy to .env; this key stays on the local server and must never be committed.
# Required for chat AND for web search: MERLIN looks things up with Meta's hosted search using this same key.
# Without it the main page shows "Web search unavailable" and MERLIN says so instead of guessing.
META_API_KEY=
# Standard Meta model. Contributor variants are rejected by this prototype.
META_MODEL=muse-spark-1.3
PORT=3000
# Separate voice development lab. Uses the same server-side Meta API key.
VOICE_PORT=3001
# Memory engine: legacy (default) or v2. See docs/MEMORY_V2.md. Switching takes one restart and keeps both stores.
# MERLIN_MEMORY_ENGINE=legacy
# v2 semantic retrieval needs a real local embedding service. Check it with: npm run check:memory-v2
# MERLIN_EMBEDDING_URL=http://127.0.0.1:11434
# MERLIN_EMBEDDING_MODEL=nomic-embed-text
# Default calibrated for nomic-embed-text on synthetic text. Any other model needs npm run calibrate:memory-v2.
# MERLIN_MEMORY_SEMANTIC_CUTOFF=0.525
# Optional public Spotify application Client ID; also configurable in the UI.
# Register http://127.0.0.1:3000/api/spotify/callback in its redirect URIs.
# No client secret is used. Tokens stay in ignored local data/spotify.json.
SPOTIFY_CLIENT_ID=

# Home devices (Home Assistant, Philips Hue, Shelly, SwitchBot, Rachio) need no environment variables.
# Set them up at http://127.0.0.1:3000/connections/ ; credentials are stored only in ignored data/connectors.json.
