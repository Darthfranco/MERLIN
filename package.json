{
  "name": "merlin-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MERLIN local assistant prototype and separate Meta/Kokoro voice lab",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "connections": "node src/connections-server.js",
    "dev:connections": "node --watch src/connections-server.js",
    "test": "node --test",
    "check:meta": "node --env-file-if-exists=.env scripts/check-meta.js",
    "check:lookup": "node --env-file-if-exists=.env scripts/check-lookup.js",
    "check:household": "node --env-file-if-exists=.env scripts/check-household.js",
    "check:memory-v2": "node --env-file-if-exists=.env scripts/check-memory-v2.js",
    "calibrate:memory-v2": "node --env-file-if-exists=.env scripts/calibrate-memory-v2.js",
    "check:connectors": "node scripts/check-connectors.js",
    "setup:voice": "bash scripts/voice-setup.sh",
    "prepare:acknowledgments": "node scripts/prepare-acknowledgments.js",
    "check:acknowledgments": "node scripts/check-acknowledgments.js",
    "check:camera": "node --env-file-if-exists=.env scripts/check-camera.js",
    "voice": "node --env-file-if-exists=.env src/voice-server.js",
    "voice:compare": "node src/voice-compare-server.js",
    "setup:voice-compare": "bash scripts/voice-compare-setup.sh",
    "dev:voice": "node --env-file-if-exists=.env --watch src/voice-server.js",
    "check:voice": "node --env-file-if-exists=.env scripts/voice-check.js",
    "check:voice-session": "node --env-file-if-exists=.env scripts/voice-session-check.js",
    "phone": "node src/phone-server.js",
    "dev:phone": "node --watch src/phone-server.js"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
