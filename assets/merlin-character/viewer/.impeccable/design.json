      "description": "Persistent label above a full-width editor field.",
      "html": "<label class=\"ds-label\" for=\"ds-screen-title\">Title</label><input class=\"ds-field\" id=\"ds-screen-title\" value=\"Hello, world.\" maxlength=\"70\">",
