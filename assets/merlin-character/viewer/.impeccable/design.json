      "kind": "input",
      "refersTo": "field",
      "description": "Native selection; the separate Play action starts the chosen destination.",
      "html": "<label class=\"ds-select-label\" for=\"ds-mode\">Choose a mood or action</label><select class=\"ds-select\" id=\"ds-mode\"><optgroup label=\"Body\"><option>Ready to help</option><option>Music &amp; dance</option><option>Deep thought</option></optgroup><optgroup label=\"Screens\"><option>Pull a screen from the right</option><option>Pull a screen from the left</option></optgroup></select>",
